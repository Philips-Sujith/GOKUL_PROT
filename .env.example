# Ushna Kaappaan — Environment Configuration Example
# Copy this file to .env and configure your environment

# Application Mode: LIVE or DEMO
APP_MODE=LIVE

# Database Configuration (Defaults to SQLite; configure MySQL if running MySQL server)
DATABASE_URL=sqlite:///./ushna_kaappaan.db
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/ushna_kaappaan

# Open-Meteo Weather API (Free tier, no API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Refresh Cycle (Hours)
WEATHER_REFRESH_INTERVAL_HOURS=2

# Telegram Early Warning Bot Configuration
# If left empty, the system automatically uses the MOCK/TEST notification transport
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@ushna2026
JWT_SECRET=ushna-kaappaan-jwt-secret-key-change-in-production

# Server Port
PORT=8000
HOST=0.0.0.0
